# HubSpot — required for contact + access-tool forms
# Development → Keys → Service keys (or Settings → Integrations → Service keys)
# Scope: crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=
# Optional: override internal names if you named HubSpot properties differently
# HUBSPOT_FORM_TYPE_PROPERTY=nucleus_form_type
# HUBSPOT_MODULE_PROPERTY=nucleus_module
# Optional: multi-line text property for contact-form message only
# HUBSPOT_MESSAGE_PROPERTY=website_message

# Resend (https://resend.com) — optional inbox copy when a lead is saved
RESEND_API_KEY=
RESEND_FROM_EMAIL="Vulcan Automations <onboarding@resend.dev>"
CONTACT_TO_EMAIL=you@yourdomain.com
